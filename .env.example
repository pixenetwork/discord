# Discord
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
AQUAPHORIA_GUILD_ID=
AQUAPHORIA_OWNER_USER_ID=

# Runtime
# 8790 is reserved for the dedicated Aquaphoria worker; Pixel Network HQ Jarvis uses 8787.
PORT=8790
DATA_DIR=./data
AQUAPHORIA_DEFAULT_MARKUP_PERCENT=5

# Discord Privileged Intents: all features OFF until explicitly reviewed/approved.
# Member lifecycle: join/leave notices, optional welcome, bounded join-burst alerts.
AQUAPHORIA_MEMBER_EVENTS_ENABLED=false
AQUAPHORIA_WELCOME_CHANNEL_ID=
AQUAPHORIA_STAFF_ALERT_CHANNEL_ID=
AQUAPHORIA_JOIN_WINDOW_SECONDS=60
AQUAPHORIA_JOIN_BURST_THRESHOLD=25

# Message Content Intent: admin-selected marketplace text channels ONLY.
# No raw message content is written to the bot's datastore or included in alerts.
AQUAPHORIA_MODERATION_ENABLED=false
AQUAPHORIA_MODERATION_CHANNEL_IDS=
AQUAPHORIA_BLOCKED_DOMAINS=

# Presence Intent: visible Discord activities, not authoritative in-game player data.
AQUAPHORIA_FIVEM_ACTIVITY_ENABLED=false
AQUAPHORIA_FIVEM_ACTIVITY_MATCHES=fivem
# Create a role members can self-assign with /fivem hide. Required to enable presence monitoring.
AQUAPHORIA_FIVEM_OPT_OUT_ROLE_ID=

# Bot's own activity does NOT require Presence Intent.
AQUAPHORIA_BOT_ACTIVITY_NAME=

# Shopify Admin API
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_LOCATION_ID=

# OpenAI /gpt control layer
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Jarvis research handoff
JARVIS_RESEARCH_ENDPOINT=
JARVIS_RESEARCH_API_KEY=

# Aquapedia persistence (GitHub contents API)
AQUAPEDIA_GITHUB_TOKEN=
AQUAPEDIA_REPOSITORY=pixenetwork/aquapedia
AQUAPEDIA_BRANCH=main
